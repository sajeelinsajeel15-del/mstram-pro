<!DOCTYPE html>
<html lang="hi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MStram Pro - 2050 Futuristic Creator & Viewer Ecosystem Hub</title>
    <style>
        :root {
            --bg-color: #050b14;
            --panel-bg: rgba(10, 16, 28, 0.92);
            --neon-green: #00ffcc;
            --neon-cyan: #00e5ff;
            --neon-purple: #b000ff;
            --neon-pink: #ff007f;
            --vip-gold: #ffcc00;
            --text-main: #ffffff;
            --text-muted: #8b9bb4;
        }
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }
        body {
            background-color: var(--bg-color);
            color: var(--text-main);
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            overflow-x: hidden;
        }
        .app-container {
            width: 100%;
            max-width: 480px;
            height: 100vh;
            max-height: 900px;
            background: var(--panel-bg);
            border: 2px solid var(--neon-cyan);
            box-shadow: 0 0 25px rgba(0, 229, 255, 0.35);
            display: flex;
            flex-direction: column;
            position: relative;
            overflow: hidden;
        }
        /* Top Header & Search */
        .app-header {
            padding: 12px 16px;
            background: rgba(3, 7, 14, 0.95);
            border-bottom: 1px solid var(--neon-cyan);
            display: flex;
            align-items: center;
            gap: 10px;
        }
        .app-title {
            font-size: 15px;
            font-weight: bold;
            color: var(--neon-green);
            white-space: nowrap;
        }
        .search-box {
            flex: 1;
            display: flex;
            background: rgba(255, 255, 255, 0.08);
            border: 1px solid var(--neon-cyan);
            border-radius: 20px;
            padding: 6px 12px;
            align-items: center;
        }
        .search-box input {
            background: transparent;
            border: none;
            color: white;
            outline: none;
            width: 100%;
            font-size: 13px;
        }
        .feature-icon-btn {
            background: var(--neon-purple);
            border: none;
            color: white;
            width: 34px;
            height: 34px;
            border-radius: 50%;
            cursor: pointer;
            font-weight: bold;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 0 10px var(--neon-purple);
        }
        
        /* Scrollable Content Area */
        .content-area {
            flex: 1;
            overflow-y: auto;
            padding: 12px;
            display: flex;
            flex-direction: column;
            gap: 14px;
        }
        
        /* Earning Banner / Post Section */
        .earning-banner {
            background: linear-gradient(135deg, #162447, #1f4068);
            border: 1px solid var(--vip-gold);
            border-radius: 10px;
            padding: 14px;
            text-align: center;
            box-shadow: 0 0 12px rgba(255, 204, 0, 0.25);
        }
        .earning-banner h3 {
            color: var(--vip-gold);
            font-size: 14px;
            margin-bottom: 6px;
        }
        .earning-banner p {
            font-size: 11px;
            color: var(--text-muted);
        }

        /* YouTube-style Video Feed */
        .video-feed-section h4 {
            font-size: 12px;
            color: var(--neon-cyan);
            margin-bottom: 8px;
            letter-spacing: 0.5px;
        }
        .video-card {
            background: rgba(8, 13, 24, 0.95);
            border: 1px solid rgba(0, 229, 255, 0.3);
            border-radius: 8px;
            overflow: hidden;
            margin-bottom: 12px;
        }
        .thumbnail-container {
            width: 100%;
            height: 175px;
            position: relative;
            background: #111;
        }
        .thumbnail-container img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }
        .video-duration {
            position: absolute;
            bottom: 8px;
            right: 8px;
            background: rgba(0, 0, 0, 0.85);
            color: white;
            font-size: 10px;
            padding: 2px 6px;
            border-radius: 4px;
            font-weight: bold;
        }
        .video-info-section {
            padding: 10px;
            display: flex;
            flex-direction: column;
            gap: 8px;
        }
        .video-main-row {
            display: flex;
            gap: 10px;
        }
        .channel-avatar {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            background: var(--neon-purple);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 13px;
            font-weight: bold;
            color: white;
            flex-shrink: 0;
            border: 1px solid var(--neon-cyan);
        }
        .video-details h5 {
            font-size: 13px;
            color: var(--text-main);
            margin-bottom: 3px;
            line-height: 1.3;
        }
        .video-details p {
            font-size: 11px;
            color: var(--text-muted);
        }
        /* YouTube Actions Row (Likes, Share, Download) */
        .youtube-actions {
            display: flex;
            justify-content: space-around;
            border-top: 1px solid rgba(255, 255, 255, 0.08);
            padding-top: 8px;
            margin-top: 2px;
        }
        .action-btn {
            background: transparent;
            border: none;
            color: var(--text-muted);
            font-size: 11px;
            display: flex;
            align-items: center;
            gap: 5px;
            cursor: pointer;
        }
        .action-btn:hover {
            color: var(--neon-green);
        }
        .action-btn svg {
            width: 16px;
            height: 16px;
            fill: currentColor;
        }

        /* Dashboard Monitor & Metrics */
        .monitor-card {
            background: rgba(8, 13, 24, 0.95);
            border: 1px solid var(--neon-green);
            border-radius: 8px;
            padding: 12px;
        }
        .monitor-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 10px;
            font-size: 12px;
            font-weight: bold;
            color: var(--neon-green);
        }
        .metric-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 8px;
            font-size: 12px;
        }
        .metric-item {
            background: rgba(255, 255, 255, 0.04);
            padding: 8px;
            border-radius: 6px;
            border-left: 3px solid var(--neon-cyan);
        }
        .metric-item span {
            display: block;
            color: var(--text-muted);
            font-size: 10px;
        }
        .metric-item strong {
            color: var(--text-main);
            font-size: 13px;
        }

        /* 30 God-Tier Futures Matrix */
        .matrix-section h4 {
            font-size: 12px;
            color: var(--neon-pink);
            margin-bottom: 8px;
            letter-spacing: 0.5px;
        }
        .matrix-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 6px;
        }
        .matrix-box {
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid var(--neon-purple);
            border-radius: 5px;
            padding: 6px 2px;
            text-align: center;
            font-size: 9px;
            font-weight: bold;
        }
        .matrix-box.active {
            border-color: var(--vip-gold);
            background: rgba(255, 204, 0, 0.08);
            color: var(--vip-gold);
        }
        .matrix-box.locked {
            border-color: rgba(139, 155, 180, 0.3);
            opacity: 0.45;
            color: var(--text-muted);
        }

        /* YouTube-style Bottom Navigation */
        .bottom-nav {
            height: 56px;
            background: rgba(3, 7, 14, 0.98);
            border-top: 1px solid rgba(0, 229, 255, 0.25);
            display: flex;
            justify-content: space-around;
            align-items: center;
        }
        .nav-item {
            display: flex;
            flex-direction: column;
            align-items: center;
            color: var(--text-muted);
            font-size: 10px;
            cursor: pointer;
            text-decoration: none;
        }
        .nav-item.active {
            color: var(--neon-green);
        }
        .nav-item svg {
            width: 20px;
            height: 20px;
            fill: currentColor;
            margin-bottom: 2px;
        }
    </style>
</head>
